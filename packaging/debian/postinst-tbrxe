#!/bin/sh
set -e

NAME=thunderbolt-tbrxe
VERSION=@VERSION@

case "$1" in
    configure)
        if command -v dkms >/dev/null 2>&1; then
            if ! dkms status -m "$NAME" -v "$VERSION" 2>/dev/null | grep -q .; then
                dkms add -m "$NAME" -v "$VERSION"
            fi
            failed=
            for modules_dir in /lib/modules/*; do
                [ -d "$modules_dir/build" ] || continue
                kernelver=${modules_dir##*/}
                # tbframe links against the installed tbfix core for the SAME
                # kernel. Old modules trees can remain after their matching
                # tbfix build was removed; they are not valid targets.
                if ! dkms status -m thunderbolt-tbfix -k "$kernelver" 2>/dev/null |
                        grep -q ': installed'; then
                    echo "thunderbolt-tbrxe: skipping $kernelver (no installed thunderbolt-tbfix)"
                    continue
                fi
                if dkms status -m "$NAME" -v "$VERSION" -k "$kernelver" 2>/dev/null |
                        grep -q ': installed'; then
                    continue
                fi
                if ! dkms install -m "$NAME" -v "$VERSION" -k "$kernelver"; then
                    echo "thunderbolt-tbrxe: failed to install for $kernelver" >&2
                    failed=1
                fi
            done
            [ -z "$failed" ] || exit 1
        fi
        # Deliberately no modules-load.d and no modprobe here: loading the
        # engine is an operator action (`modprobe tbrxe`), and module load
        # ordering on a live Thunderbolt link is owned by the deploy procedure.
        ;;
esac

exit 0
