#!/bin/sh
set -e

NAME=thunderbolt-tbfix
VERSION=@VERSION@

case "$1" in
    remove|deconfigure)
        if command -v dkms >/dev/null 2>&1; then
            dkms remove -m "$NAME" -v "$VERSION" --all 2>/dev/null || true
        fi
        # Regenerate the initramfs so the stock in-tree thunderbolt is restored
        # at the next boot rather than the removed DKMS build (upgrade is handled
        # by the new version's postinst, so skip it here).
        if command -v update-initramfs >/dev/null 2>&1; then
            update-initramfs -u -k all || true
        fi
        ;;
    upgrade)
        if command -v dkms >/dev/null 2>&1; then
            dkms remove -m "$NAME" -v "$VERSION" --all 2>/dev/null || true
        fi
        ;;
esac

exit 0
