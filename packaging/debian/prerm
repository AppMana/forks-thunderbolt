#!/bin/sh
set -e

NAME=thunderbolt-tbfix
VERSION=@VERSION@

case "$1" in
    remove|deconfigure)
        if command -v dkms >/dev/null 2>&1; then
            dkms remove -m "$NAME" -v "$VERSION" --all 2>/dev/null || true
        fi
        # dkms >= 3.0 dropped REMAKE_INITRD, so this explicit refresh is the
        # only one: once our updates/dkms modules are gone, depmod/initramfs
        # resolve the module names back to the in-tree kernel/ copies.
        if command -v update-initramfs >/dev/null 2>&1; then
            update-initramfs -u -k all || true
        fi
        ;;
    upgrade)
        if command -v dkms >/dev/null 2>&1; then
            dkms remove -m "$NAME" -v "$VERSION" --all 2>/dev/null || true
        fi
        ;;
esac

exit 0
