#!/bin/sh
set -e

NAME=thunderbolt-tbfix
VERSION=@VERSION@

case "$1" in
    configure)
        if command -v dkms >/dev/null 2>&1; then
            if ! dkms status -m "$NAME" -v "$VERSION" 2>/dev/null | grep -q .; then
                dkms add -m "$NAME" -v "$VERSION"
            fi
            # An upgrade removes the previous DKMS version from every kernel
            # before this script runs. `dkms autoinstall` may rebuild only the
            # running kernel, leaving a saved fallback boot without tbfix.
            # Build every installed kernel that has a usable build tree.
            failed=
            for modules_dir in /lib/modules/*; do
                [ -d "$modules_dir/build" ] || continue
                kernelver=${modules_dir##*/}
                case "$kernelver" in
                    7.0.*) ;;
                    *)
                        echo "thunderbolt-tbfix: skipping unsupported kernel $kernelver"
                        continue
                        ;;
                esac
                if dkms status -m "$NAME" -v "$VERSION" -k "$kernelver" 2>/dev/null |
                        grep -q ': installed'; then
                    continue
                fi
                if ! dkms install -m "$NAME" -v "$VERSION" -k "$kernelver"; then
                    echo "thunderbolt-tbfix: failed to install for $kernelver" >&2
                    failed=1
                fi
            done
            [ -z "$failed" ] || exit 1
        fi
        # thunderbolt/thunderbolt_net are pulled into the initramfs (early boot).
        # dkms >= 3.0 dropped REMAKE_INITRD, so this explicit call is the ONLY
        # thing refreshing the initramfs on package install — it must stay, and
        # it covers ALL installed kernels so a STALE initramfs can't keep
        # loading the in-tree kernel/ copy instead of our updates/dkms one
        # (that stale-initramfs case was the old boot -22). initramfs-tools
        # resolves module names via modules.dep, which the "search updates ..."
        # depmod order points at updates/dkms/, so the refresh bakes OUR modules.
        if command -v update-initramfs >/dev/null 2>&1; then
            update-initramfs -u -k all || true
        fi
        ;;
esac

exit 0
