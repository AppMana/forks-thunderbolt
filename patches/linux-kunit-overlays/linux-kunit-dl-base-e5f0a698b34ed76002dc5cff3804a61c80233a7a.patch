+static int tbv_query_gid(struct ib_device *ibdev, u32 port_num, int index,
+			 union ib_gid *gid)
+{
+	/*
+	 * RoCE GIDs come from the rail's bound netdev (ib_core roce_gid_mgmt),
+	 * not from here; this static entry is only a fallback for the cache.
