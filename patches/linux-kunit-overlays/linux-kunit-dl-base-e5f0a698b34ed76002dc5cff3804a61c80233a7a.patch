+	INIT_LIST_HEAD(&tqp->pending_sends);
+	INIT_LIST_HEAD(&tqp->pending_reads);
+	INIT_LIST_HEAD(&tqp->pending_read_resps);
+	INIT_LIST_HEAD(&tqp->apple_sq);
