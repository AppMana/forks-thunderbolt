+static u32 tbv_debugfs_wire_path_flags(const struct tbv_path *path)
+{
+	u32 flags = 0;
+
+	if (path->cfg.tx_flags & RING_FLAG_FRAME)
+		flags |= TBV_NATIVE_WIRE_PATH_FRAME;
+	if (path->cfg.e2e)
+		flags |= TBV_NATIVE_WIRE_PATH_E2E;
+
+	return flags;
+}
