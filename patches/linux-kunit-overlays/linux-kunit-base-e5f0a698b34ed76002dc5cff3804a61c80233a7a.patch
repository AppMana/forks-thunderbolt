+struct cm_terminal_release_fixture {
+	struct tb_switch *host;
+	struct tb_nhi *nhi;
+	struct tb *tb;
+	struct tb_tunnel *tunnels[CM_TERMINAL_TUNNELS];
+	struct tb_port *owned_port;
+	unsigned int owned_credits;
+	struct list_head tunnel_list;
+};
