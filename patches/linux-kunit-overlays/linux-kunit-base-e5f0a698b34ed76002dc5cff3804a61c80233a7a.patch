+static bool tb_xdomain_quarantine_is_last(struct tb_xdomain_quarantine *q)
+{
+	struct tb_xdomain_quarantine *other;
+
+	list_for_each_entry(other, &xdomain_quarantines, list) {
+		if (other != q && other->xd == q->xd)
+			return false;
+	}
+	return true;
