+	       ((u32)(eof & 0x0f) << 12) |
+	       ((u32)(sof & 0x0f) << 16) |
+	       ((u32)(flags & 0x0fff) << 20);
+}
+
+static u16 ring_descriptor_length(u32 word)
+{
+	return word & 0x0fff;
+}
+
+static u8 ring_descriptor_eof(u32 word)
+{
+	return (word >> 12) & 0x0f;
+}
+
+static u8 ring_descriptor_sof(u32 word)
+{
+	return (word >> 16) & 0x0f;
+}
+
+static u16 ring_descriptor_flags(u32 word)
+{
+	return (word >> 20) & 0x0fff;
+}
