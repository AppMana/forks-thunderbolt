+		tb_port_enable(lane1);
+		tcm->last_retrain_at = jiffies;
+		port->replug_last_attempt = jiffies;
+		lane1->retrain_last_attempt = jiffies;
+		port->retrain_state_since = jiffies;
+		port->replug_phase = TB_REPLUG_IDLE;
+		return;
+	}
+}
