+	for (i = 0; i < diag->completed_count; i++) {
+		if (diag->completed[i].frame != frame)
+			continue;
+		*evidence = diag->completed[i].evidence;
+		ret = 0;
+		break;
+	}
+out:
+	spin_unlock_irqrestore(&ring->lock, flags);
+	return ret;
+}
