+}
+
+void retransmit_timer(struct timer_list *t);
+void rnr_nak_timer(struct timer_list *t);
+
+/* rxe_comp.c: bounded first-retransmit delay (fork; sub-ms RTT fabric) */
+extern uint tbrxe_retransmit_base_ms;
