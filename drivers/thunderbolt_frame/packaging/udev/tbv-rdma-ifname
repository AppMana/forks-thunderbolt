#!/bin/sh
# tbv-rdma-ifname: udev PROGRAM helper. Prints a stable, per-link name for the
# usb4_rdma GID-only netdev that the thunderbolt_frame_rxe engine creates per
# rail (kernel name u4r<N>, enumeration-order and unstable).
#
# As of 0.2.15 the peer identity lives on the netdev itself (tbv_peer_name /
# tbv_peer_uuid), because the netdev parents to the stable NHI device rather
# than the XDomain device. Falls back to the parent XDomain attrs for older
# (xd-parented) netdevs. Needs NO site configuration.
#
# Naming priority:
#   1. tbr-<peer-hostname-tail>  -- peer kernel hostname
#   2. tbr-<peer-uuid-prefix>    -- stable peer hardware UUID
#   3. (no rename)               -- keep the kernel's u4r<N> name
# Names stay within the 15-char ifname limit ("tbr-" + up to 11).
set -u
iface="${1:-}"
[ -n "$iface" ] || exit 0
nd="/sys/class/net/${iface}"

# Intra-domain self-loop (docs/tb_same_host.md): the peer IS this host, so
# tbr-<peer-hostname> would collide across the loop's two netdevs (the
# second rename fails and the name becomes enumeration-dependent). Name by
# the end's own route instead: tbr-lo<route-hex>, distinct by construction.
peer_uuid=$(cat "${nd}/tbv_peer_uuid" 2>/dev/null | tr -cd '0-9a-f')
local_uuid=$(cat /sys/bus/thunderbolt/devices/0-0/unique_id 2>/dev/null | tr -cd '0-9a-f')
[ -n "$local_uuid" ] || local_uuid=$(cat /sys/bus/thunderbolt/devices/*-0/unique_id 2>/dev/null | head -n1 | tr -cd '0-9a-f')
if [ -n "$peer_uuid" ] && [ "$peer_uuid" = "$local_uuid" ]; then
	route=$(cat "${nd}/tbv_route" 2>/dev/null | tr -cd '0-9a-f')
	if [ -n "$route" ]; then
		printf 'tbr-lo%s' "$(printf '%s' "$route" | tail -c 9)"
		exit 0
	fi
fi

host=$(cat "${nd}/tbv_peer_name" 2>/dev/null | tr -cd 'A-Za-z0-9')
[ -n "$host" ] || host=$(cat "${nd}/device/device_name" 2>/dev/null | tr -cd 'A-Za-z0-9')
if [ -n "$host" ]; then
	printf 'tbr-%s' "$(printf '%s' "$host" | tail -c 11)"
	exit 0
fi

uid=$(cat "${nd}/tbv_peer_uuid" 2>/dev/null | tr -cd '0-9a-f')
[ -n "$uid" ] || uid=$(cat "${nd}/device/unique_id" 2>/dev/null | tr -cd '0-9a-f')
if [ -n "$uid" ]; then
	printf 'tbr-%s' "$(printf '%s' "$uid" | cut -c1-12)"
	exit 0
fi

exit 0
