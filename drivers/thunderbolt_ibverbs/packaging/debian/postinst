#!/bin/sh
set -e

NAME=thunderbolt-ibverbs
VERSION=@VERSION@

case "$1" in
    configure)
        if command -v dkms >/dev/null 2>&1; then
            if ! dkms status -m "$NAME" -v "$VERSION" 2>/dev/null | grep -q .; then
                dkms add -m "$NAME" -v "$VERSION"
            fi
            failed=
            for modules_dir in /lib/modules/*; do
                [ -d "$modules_dir/build" ] || continue
                kernelver=${modules_dir##*/}
                # BUILD_DEPENDS is per-kernel. Old modules trees can remain
                # after their matching tbfix build was removed; they are not
                # valid ibverbs targets and must not poison this package.
                if ! dkms status -m thunderbolt-tbfix -k "$kernelver" 2>/dev/null |
                        grep -q ': installed'; then
                    echo "thunderbolt-ibverbs: skipping $kernelver (no installed thunderbolt-tbfix)"
                    continue
                fi
                if dkms status -m "$NAME" -v "$VERSION" -k "$kernelver" 2>/dev/null |
                        grep -q ': installed'; then
                    continue
                fi
                if ! dkms install -m "$NAME" -v "$VERSION" -k "$kernelver"; then
                    echo "thunderbolt-ibverbs: failed to install for $kernelver" >&2
                    failed=1
                fi
            done
            [ -z "$failed" ] || exit 1
        fi
        # Pick up the usb4_rdma netdev naming rule (no-op if udev not running).
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules 2>/dev/null || true
            udevadm trigger --subsystem-match=net --action=add 2>/dev/null || true
        fi
        ;;
esac

exit 0
