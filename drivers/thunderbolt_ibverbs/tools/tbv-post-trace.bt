#!/usr/bin/env bpftrace
/*
 * Answers "why did the application see a completion error while the driver's
 * counters look idle" without rebuilding the module.
 *
 * The driver reports IBV_WC_RETRY_EXC_ERR by storing -ETIMEDOUT on a send
 * context and handing it to tbv_send_complete(), so the completion status is
 * the second argument of that function. Counting the statuses that actually
 * reach it separates "no WR ever completed in error" from "a WR completed in
 * error through a path that increments no counter" -- the two views the
 * debugfs summary cannot tell apart, because data_wr_retry_exhausted is
 * incremented on only two of the branches that store -ETIMEDOUT.
 *
 * post_send return values are counted the same way: a nonzero return is the
 * "Couldn't post send" perftest prints, and its value distinguishes a QP that
 * left RTS (-EINVAL, counted nowhere) from a resource shortage (-ENOMEM).
 *
 * status/retval legend: 0 ok, -11 EAGAIN (RNR exhausted -> RNR_RETRY_EXC_ERR),
 * -22 EINVAL, -110 ETIMEDOUT (-> RETRY_EXC_ERR), -125 ECANCELED (flush),
 * -5 EIO (remote op error).
 *
 * usage: sudo bpftrace tbv-post-trace.bt   (reports after TBV_TRACE_SECS)
 */

BEGIN { printf("tbv post/complete trace started\n"); }

kprobe:tbv_post_send			{ @post_calls = count(); }
kretprobe:tbv_post_send			{ @post_ret[(int64)retval] = count(); }

kretprobe:tbv_post_send_one
/(int64)retval != 0/
{
	@post_one_err[(int64)retval] = count();
	@post_one_err_stack[kstack(6)] = count();
}

/* isra clone: the (ctx, status) signature is preserved, status is arg1 */
kprobe:tbv_send_complete.isra.0		{ @complete_status[(int64)arg1] = count(); }

/*
 * Order matters more than totals here. Once one WR fails the QP, every other
 * pending WR is completed too, so a histogram alone cannot say which status
 * came first -- and perftest prints whichever the CQ hands it first. Print the
 * first few in arrival order with their stacks.
 */
kprobe:tbv_send_complete.isra.0
/(int64)arg1 != 0/
{
	@complete_err_stack[kstack(10)] = count();
	@nerr = @nerr + 1;
	if (@nerr <= 12) {
		printf("[%llu] complete status=%d\n", nsecs, (int64)arg1);
		print(kstack(10));
	}
}

kprobe:tbv_qp_mark_error_event.isra.0 { printf("[%llu] qp_mark_error_event\n", nsecs); }
kprobe:tbv_qp_flush_sends	{ printf("[%llu] qp_flush_sends\n", nsecs); }

kretprobe:tbv_native_send_ctx_post_frames
/(int64)retval != 0/
{
	@post_frames_err[(int64)retval] = count();
}

interval:s:$1 { exit(); }
