#!/usr/bin/env bpftrace
/*
 * Sender-side timeline of one tbv native SEND/WRITE, keyed by send ctx ptr.
 * (tbv_note_matched_send_ack is inlined, so the WR completion tbv_send_complete
 *  -- which only runs after the peer SEND_ACK is matched -- anchors the ACK leg.)
 * Legs (ns histograms):
 *   post_to_txdone   : post_frames entry -> local TX ring completion
 *                      (DEFER + schedule_tx + DMA + tx irq; our frames left)
 *   txdone_to_complete: local TX done -> WR completion (the ACK RTT wait +
 *                      completion push)
 *   post_to_complete : post_frames entry -> WR completion (total in-kernel send)
 *   kick_to_sched    : path_kick_tx -> path_schedule_tx (deferred-post cost)
 * Run on the sender node during ib_send_lat, then it exits after 20s.
 */
kprobe:tbv_native_send_ctx_post_frames { @post[arg0] = nsecs; }

kprobe:tbv_send_tx_done /@post[arg0]/ {
    @txdone_ts[arg0] = nsecs;
    @post_to_txdone = hist(nsecs - @post[arg0]);
    @n_txdone = count();
}

kprobe:tbv_send_complete.isra.0 /@post[arg0]/ {
    if (@txdone_ts[arg0]) {
        @txdone_to_complete = hist(nsecs - @txdone_ts[arg0]);
    }
    @post_to_complete = hist(nsecs - @post[arg0]);
    @n_complete = count();
    delete(@txdone_ts[arg0]);
    delete(@post[arg0]);
}

kprobe:tbv_path_kick_tx { @kick[tid] = nsecs; }
kprobe:tbv_path_schedule_tx /@kick[tid]/ {
    @kick_to_sched = hist(nsecs - @kick[tid]);
    delete(@kick[tid]);
}

interval:s:20 { exit(); }
END { clear(@post); clear(@txdone_ts); clear(@kick); }
