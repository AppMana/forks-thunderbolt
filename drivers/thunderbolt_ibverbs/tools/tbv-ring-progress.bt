#!/usr/bin/env bpftrace
/*
 * Tell a real NHI TX ring stall apart from a driver-side accounting artifact.
 *
 * The driver's "tx stall route=... inflight=1 posted=N completed=N-1" warning
 * is emitted from tbv_path_tx_poll_work() and only knows what that poll reaped.
 * The ring is interrupt-driven, so ring_work() takes almost every completion
 * and the poll sees the tail. Before this script existed, a healthy ring warned
 * every tx_stall_warn_ms forever (see
 * traces/baseline-025-023/hang-appmana-023.txt, where posted AND completed both
 * advance by five between consecutive warnings).
 *
 * This counts the two things the warning cannot separate:
 *   posts       - frames handed to the ring by tb_ring_tx()
 *   completions - frames the ring gave back, by the context that reaped them
 *
 * A ring that is genuinely stuck shows posts climbing with BOTH completion
 * counters flat and @outstanding pinned. A ring that is merely invisible to the
 * poll shows @completed_irq climbing and @completed_poll near zero, with
 * @outstanding oscillating around a small number. Only the first is a bug.
 *
 * Usage (on the sending node, while the reproducer runs):
 *   sudo drivers/thunderbolt_ibverbs/tools/tbv-ring-progress.bt
 * Prints every 5 s so the cadence lines up with the driver's own warning.
 */

BEGIN
{
	printf("tracing tb_ring_tx and the tbv TX completion callback; ctrl-c to stop\n");
}

kprobe:tb_ring_tx
{
	@posts[arg0] = count();
	@outstanding[arg0] = @outstanding[arg0] + 1;
}

/*
 * Both completion callbacks. arg0 is the ring, so the counters key the same way
 * as the posts and a per-ring imbalance is visible directly.
 */
/*
 * Which context reaped it. Both ring_work() and the driver's poll run on a
 * kworker, so comm cannot tell them apart; mark the poll's own thread instead.
 * The callbacks are static but appear in kallsyms (possibly suffixed .isra.0 --
 * check /proc/kallsyms and adjust if a probe fails to attach).
 */
kprobe:tbv_path_tx_poll_work { @in_poll[tid] = 1; }
kretprobe:tbv_path_tx_poll_work { delete(@in_poll[tid]); }

kprobe:tbv_path_tx_complete,
kprobe:tbv_path_zcopy_tx_complete
{
	@outstanding[arg0] = @outstanding[arg0] - 1;
	if (@in_poll[tid]) {
		@completed_poll[arg0] = count();
	} else {
		@completed_irq[arg0] = count();
	}
}

/* A stall the driver itself decided to report; correlate with the counters. */
kprobe:tbv_path_tx_stalled
{
	@stall_gate_calls = count();
}

interval:s:5
{
	time("%H:%M:%S ");
	printf("---- ring progress ----\n");
	print(@posts);
	print(@completed_irq);
	print(@completed_poll);
	print(@outstanding);
}
